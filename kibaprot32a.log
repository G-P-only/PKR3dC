        # MLP
        self.classifier = nn.Sequential(
            nn.Linear(640, 1024),
            nn.BatchNorm1d(1024),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(1024, 1024),
            nn.BatchNorm1d(1024),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(1024, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(),
            nn.Linear(256, 1)
        )

    def forward(self, data):
        drug_graph, data, drug_group_graph, drug_MoLFormer_emb, prot_ankh_emb = data[0], data[1], data[2], data[3], data[4]
        # *****池化注意力增强特征表示######test_loss:0.1379, test_cindex:0.9143, test_r2:0.8015######davisgroup-am-gca.log
        # *****drugs
        # drug_MolFormer_emb
        # drug_MoLFormer_emb.pool = torch.stack([outer[0][0] for outer in drug_MoLFormer_emb.pool], dim=0)
        drug_MoLFormer_emb.x = self.mol_former_f(drug_MoLFormer_emb.x)
        drug_MoLFormer_emb.pool = global_mean_pool(drug_MoLFormer_emb.x, drug_MoLFormer_emb.batch)
        drug_MoLFormer_emb.x, mol_former_mask = to_dense_batch(x=drug_MoLFormer_emb.x, batch=drug_MoLFormer_emb.batch)
        mol_former_pool, _ = self.molformer_gca(drug_MoLFormer_emb.pool.unsqueeze(dim=1), drug_MoLFormer_emb.x, drug_MoLFormer_emb.x, ~mol_former_mask)
        # drug_group_graph
        drug_g, drug_pool_g, drug_mask_g = self.ligand_group_graph_encoder(drug_group_graph)
        drug_g = self.d_fg(drug_g)
        drug_pool_g = masked_mean_pool(drug_g, drug_mask_g, dim=1)
        drug_pool_g, _ = self.d_gcag(drug_pool_g.unsqueeze(dim=1), drug_g, drug_g, drug_mask_g)
        # drug子结构的transformer编码
        drug_tokens, drug_e, drug_mask_s = process_drug_tokens(data)
        drug_s = self.ligand_bermol(drug_tokens, drug_e)
        drug_s = self.d_fs(drug_s)
        drug_pool_s = masked_mean_pool(drug_s, drug_mask_s, dim=1)
        drug_pool_s, _ = self.d_gcas(drug_pool_s.unsqueeze(dim=1), drug_s, drug_s, drug_mask_s)
        # *****protein
        # ankh-large
        prot_ankh_emb.x = self.ankh_f(prot_ankh_emb.x)
        ankh_pool = global_mean_pool(prot_ankh_emb.x, prot_ankh_emb.batch)
        prot_ankh_emb.x, ankh_mask = to_dense_batch(x=prot_ankh_emb.x, batch=prot_ankh_emb.batch)
        ankh_pool, _ = self.ankh_gca(ankh_pool.unsqueeze(dim=1), prot_ankh_emb.x, prot_ankh_emb.x, ~ankh_mask)
        # 异构图
        # pocket_graphs, pockets_batch = process_pocket_graphs(data.protein_graph)
        # prot, prot_mask = self.protein_encoder(pocket_graphs)
        prot, prot_mask = self.protein_encoder(data.protein_graph)
        prot = self.p_f(prot)
        prot_pool = masked_mean_pool(prot, prot_mask, dim=1)
        prot_pool, _ = self.p_gca(prot_pool.unsqueeze(dim=1), prot, prot, prot_mask)
        # fusion
        fu = torch.cat([drug_pool_s, drug_pool_g, prot_pool, mol_former_pool, ankh_pool], dim=-1).squeeze(dim=1)
        x = self.classifier(fu)
        return x

