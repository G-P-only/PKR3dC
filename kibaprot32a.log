        # # drug_MolFormer_emb
        self.mol_former_pro = nn.Linear(768, 128)
        self.mol_former_f = MaskedFeedForward(768, hidden_dim=512, output_dim=output_dim, dropout=dropout, bias=True)
        # ankh-large
        self.ankh_pro = nn.Linear(1536, 128)
        self.ankh_f = MaskedFeedForward(1536, hidden_dim=512, output_dim=output_dim, dropout=dropout, bias=True)
        # fusion
        self.p_gca = GuidedCrossAttention(embed_dim=output_dim, num_heads=1)
        self.d_gcag = GuidedCrossAttention(embed_dim=output_dim, num_heads=1)
        self.d_gcas = GuidedCrossAttention(embed_dim=output_dim, num_heads=1)
        self.molformer_gca = GuidedCrossAttention(embed_dim=output_dim, num_heads=1)
        self.ankh_gca = GuidedCrossAttention(embed_dim=output_dim, num_heads=1)
